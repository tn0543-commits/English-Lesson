                                <button class="btn bg-green-500 hover:bg-green-600 text-white py-1 rounded-lg font-bold flex flex-col items-center justify-center text-[10px] shadow-sm w-full" onclick="speak('Can I close the door, please?', 1.0)">🔊</button>
                                <button class="btn bg-green-50 hover:bg-green-100 text-green-700 py-1 rounded-lg font-bold flex flex-col items-center justify-center text-[10px] border border-green-200 w-full" onclick="speak('Can I close the door, please?', 1.5)">🐇</button>
                            </div>
                        </div>
                    </div>

                    <!-- Dialogues Lesson 2 -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-2">
                        <!-- Dialogue 1 -->
                        <div class="bg-white p-4 rounded-2xl shadow-inner border border-gray-100 flex flex-col">
                            <h3 class="text-md font-bold text-gray-700 mb-2 border-b pb-1">Dialogue 1: Entering</h3>
                            <div class="space-y-2 flex-grow">
                                <div class="bg-gray-50 p-2 rounded-lg border-l-4 border-blue-400">
                                    <p class="font-bold text-sm text-gray-800">Student: "May I come in, please?"</p>
                                    <button class="mt-1 text-[10px] bg-white text-blue-600 px-2 py-1 rounded shadow-sm hover:bg-gray-100 btn" onclick="speak('May I come in, please?')">🔊 Listen</button>
