                choices: [
                    { id: 'A', text: "Can I close the window, please?" },
                    { id: 'B', text: "Can you help me with this, please?" },
                    { id: 'C', text: "May I come in, please?" }
                ],
                correctId: 'B',
                explanation: "When you need help, use 'Can you help me...'."
            },
            {
                situationEn: "You arrive at the classroom door and want to enter.",
                choices: [
                    { id: 'A', text: "May I come in, please?" },
                    { id: 'B', text: "Can you speak slower, please?" },
                    { id: 'C', text: "Could you repeat that, please?" }
                ],
                correctId: 'A',
                explanation: "Always ask 'May I come in?' before entering a room."
            },
            {
                situationEn: "The classroom is hot. You want to open the window.",
                choices: [
                    { id: 'A', text: "Can you help me with this, please?" },
                    { id: 'B', text: "May I come in, please?" },
                    { id: 'C', text: "Can I open the window, please?" }
                ],
                correctId: 'C',
                explanation: "To open a window, you ask 'Can I open the window, please?'."
            }
        ];

        window.onload = () => {
            initStudentGrid();
            showView('view-main-menu');
            
            if (!('speechSynthesis' in window)) {
                console.warn("Text-to-Speech is not supported in this browser.");
            }
        };

        function showView(viewId) {
            document.querySelectorAll('.view-section').forEach(el => el.classList.add('hidden'));
            document.getElementById(viewId).classList.remove('hidden');
            currentView = viewId;
            
            const btnHome = document.getElementById('btn-home');
            if (viewId === 'view-main-menu' || viewId === 'view-student-select' || viewId === 'view-scoreboard') {
                btnHome.classList.add('hidden');
            } else {
                btnHome.classList.remove('hidden');
            }
            
            if (viewId === 'view-scoreboard') {
                renderScoreboard();
            }
            
            if (viewId === 'view-lesson') {
                showSlide('lesson1', 0);
            }
            if (viewId === 'view-lesson-2') {
                showSlide('lesson2', 0);
            }
        }

        function showSlide(lesson, index) {
            const slides = document.querySelectorAll(`.${lesson}-slide`);
            if (slides.length === 0) return;
            
            if (index < 0) index = 0;
            if (index >= slides.length) index = slides.length - 1;
            
            currentSlide[lesson] = index;

            slides.forEach((slide, i) => {
                if (i === index) {
                    slide.classList.remove('hidden');
                    slide.classList.add('flex');
                } else {
                    slide.classList.add('hidden');
                    slide.classList.remove('flex');
                }
            });

            // Update Prev Button
            const prevBtn = document.getElementById(`btn-prev-${lesson}`);
            if (prevBtn) {
                prevBtn.disabled = (index === 0);
                if(index === 0) {
                    prevBtn.classList.add('opacity-50', 'cursor-not-allowed');
                } else {
                    prevBtn.classList.remove('opacity-50', 'cursor-not-allowed');
                }
            }
            
            // Update Next Button
            const nextBtn = document.getElementById(`btn-next-${lesson}`);
            if (nextBtn) {
                if (index === slides.length - 1) {
                    if(lesson === 'lesson1') {
                        nextBtn.innerHTML = '<span class="hidden sm:inline">Next Lesson</span> ➡️';
                        nextBtn.onclick = () => showView('view-lesson-2');
                    } else {
                        nextBtn.innerHTML = '<span class="hidden sm:inline">Finish</span> 🏠';
                        nextBtn.onclick = () => goHome();
                    }
                } else {
                    nextBtn.innerHTML = '<span class="hidden sm:inline">Next</span> ➡️';
                    nextBtn.onclick = () => showSlide(lesson, index + 1);
                }
            }
        }

        function showModal(title, message, confirmCallback, showCancel = false) {
            document.getElementById('modal-title').innerText = title;
            document.getElementById('modal-message').innerText = message;
            
            const btnConfirm = document.getElementById('modal-btn-confirm');
            const btnCancel = document.getElementById('modal-btn-cancel');
            
            const newBtnConfirm = btnConfirm.cloneNode(true);
            btnConfirm.parentNode.replaceChild(newBtnConfirm, btnConfirm);
            
            const newBtnCancel = btnCancel.cloneNode(true);
            btnCancel.parentNode.replaceChild(newBtnCancel, btnCancel);
            
            if (showCancel) {
                newBtnCancel.classList.remove('hidden');
                newBtnCancel.onclick = () => {
                    closeModal();
                };
            } else {
                newBtnCancel.classList.add('hidden');
            }

            newBtnConfirm.onclick = () => {
                closeModal();
                if (confirmCallback) confirmCallback();
            };

            document.getElementById('custom-modal').classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('custom-modal').classList.add('hidden');
        }

        function goHome(force = false) {
            if (currentView === 'view-quiz' && quizState.active && !force) {
                showModal(
                    "Leave Quiz?", 
                    "You are in the middle of a quiz. Are you sure you want to leave? Your progress will be lost.",
                    () => {
                        quizState.active = false;
                        showView('view-main-menu');
                    },
                    true
                );
            } else {
                quizState.active = false;
                showView('view-main-menu');
            }
        }

        function initStudentGrid() {
            const grid = document.getElementById('student-grid');
            grid.innerHTML = '';
            for (let i = 1; i <= TOTAL_STUDENTS; i++) {
                const btn = document.createElement('button');
                btn.className = "btn bg-white border-2 border-orange-200 hover:border-orange-500 hover:bg-orange-50 text-orange-800 font-bold py-2 md:py-3 px-1 rounded-xl shadow flex flex-col items-center justify-center transition-transform hover:scale-105 text-sm md:text-md";
                btn.innerHTML = `<span class="text-xl mb-1">🧑‍🎓</span>Student ${i}`;
                btn.onclick = () => selectStudent(i);
                grid.appendChild(btn);
            }
        }

        function prepareQuiz() {
            if (currentStudent) {
                startQuiz();
            } else {
                showView('view-student-select');
            }
        }

        function selectStudent(id) {
            currentStudent = id;
            const badge = document.getElementById('current-student-badge');
            badge.innerText = `Student ${id}`;
            badge.classList.remove('hidden');
            startQuiz();
        }

        let synth = window.speechSynthesis;

        function speak(text, rate = 1.0, onEndCallback = null) {
            if (!synth) {
                showModal("Error", "Audio is not supported in this browser.");
                if(onEndCallback) onEndCallback();
                return;
            }
            
            synth.cancel();

            let utterance = new SpeechSynthesisUtterance(text);
            utterance.lang = 'en-US';
            utterance.rate = rate;
            
            utterance.onend = () => {
                if(onEndCallback) onEndCallback();
            };
            
            synth.speak(utterance);
        }

        function playDialogue(sentences, rate = 1.0) {
            if (!synth) return;
            synth.cancel();
            
            let i = 0;
            function nextSentence() {
                if (i < sentences.length) {
                    speak(sentences[i], rate, nextSentence);
                    i++;
                }
            }
            nextSentence();
        }

        function toggleHelpExpressions() {
            const el = document.getElementById('help-expressions');
            el.classList.toggle('hidden');
        }

        function startQuiz() {
            quizState = {
                active: true,
                currentQuestionIndex: 0,
                score: 0,
                userAnswers: new Array(quizData.length).fill(null)
            };
            renderQuestion();
            showView('view-quiz');
        }

        function renderQuestion() {
            const q = quizData[quizState.currentQuestionIndex];
            const container = document.getElementById('quiz-container');
            document.getElementById('quiz-progress').innerText = `${quizState.currentQuestionIndex + 1} / ${quizData.length}`;
            
            const safeSituation = q.situationEn.replace(/'/g, "\\'");
            const isLastQuestion = quizState.currentQuestionIndex === quizData.length - 1;
            
            let html = `
                <div class="mb-4 bg-white p-4 rounded-2xl shadow-sm border border-orange-100 flex-shrink-0">
                    <div class="flex items-start justify-between gap-3 mb-2">
                        <h3 class="text-lg font-bold text-gray-800">Situation: ${q.situationEn}</h3>
                        <button onclick="speak('${safeSituation}', 1.0)" class="btn bg-blue-100 hover:bg-blue-200 text-blue-700 p-1.5 rounded-full shadow-sm flex-shrink-0 border border-blue-200" title="Listen">🔊</button>
                    </div>
                    <div class="flex items-center justify-between gap-3">
                        <p class="text-md font-bold text-orange-600">What should you say?</p>
                        <button onclick="speak('What should you say?', 1.0)" class="btn bg-orange-100 hover:bg-orange-200 text-orange-700 p-1.5 rounded-full shadow-sm flex-shrink-0 border border-orange-200 text-xs" title="Listen">🔊</button>
                    </div>
                </div>
                <div class="space-y-2 overflow-y-auto flex-grow" id="choices-container">
            `;
            
            q.choices.forEach(choice => {
                const safeChoiceText = choice.text.replace(/'/g, "\\'");
                html += `
                    <div class="relative w-full flex items-center group">
                        <button id="choice-${choice.id}" class="btn choice-btn w-full text-left p-3 pr-14 rounded-xl border-2 border-gray-200 bg-white hover:bg-orange-50 hover:border-orange-300 font-bold text-md text-gray-700 transition-all flex items-center gap-3" onclick="selectAnswer('${choice.id}')">
                            <span class="bg-gray-100 text-gray-600 rounded-full w-8 h-8 flex flex-shrink-0 items-center justify-center font-black">${choice.id}</span>
                            <span class="flex-grow">${choice.text}</span>
                        </button>
                        <button onclick="speak('${safeChoiceText}', 1.0)" class="absolute right-3 p-1.5 bg-gray-100 hover:bg-blue-100 text-gray-600 hover:text-blue-700 rounded-full transition-colors z-10 shadow-sm border border-gray-200" title="Listen to choice">
                            🔊
                        </button>
                    </div>
                `;
            });
            
            html += `</div>
                <div class="mt-4 text-center flex-shrink-0">
                    <button id="btn-submit-question" class="btn bg-orange-500 hover:bg-orange-600 text-white px-8 py-2 rounded-full font-bold text-lg shadow-lg opacity-50 cursor-not-allowed w-full md:w-auto" disabled onclick="submitAndNext()">
                        ${isLastQuestion ? 'Submit Quiz 🏆' : 'Next Question ➡️'}
                    </button>
                </div>
            `;
            
            container.innerHTML = html;
        }

        function selectAnswer(id) {
            quizState.userAnswers[quizState.currentQuestionIndex] = id;
            
            document.querySelectorAll('.choice-btn').forEach(btn => {
                btn.classList.remove('border-orange-500', 'bg-orange-50', 'ring-2', 'ring-orange-200');
                btn.classList.add('border-gray-200', 'bg-white');
            });
            
            const selectedBtn = document.getElementById(`choice-${id}`);
            selectedBtn.classList.remove('border-gray-200', 'bg-white');
            selectedBtn.classList.add('border-orange-500', 'bg-orange-50', 'ring-2', 'ring-orange-200');
            
            const submitBtn = document.getElementById('btn-submit-question');
            submitBtn.disabled = false;
            submitBtn.classList.remove('opacity-50', 'cursor-not-allowed');
        }

        function submitAndNext() {
            if (!quizState.userAnswers[quizState.currentQuestionIndex]) return;

            if (quizState.currentQuestionIndex < quizData.length - 1) {
                quizState.currentQuestionIndex++;
                renderQuestion();
            } else {
                finishQuiz();
            }
        }

        function finishQuiz() {
            quizState.active = false;
            
            // Calculate final total score at the very end
            let calculatedScore = 0;
            quizData.forEach((q, idx) => {
                if (quizState.userAnswers[idx] === q.correctId) {
                    calculatedScore++;
                }
            });
            quizState.score = calculatedScore;
            
            saveScore(currentStudent, quizState.score, quizData.length);
            
            document.getElementById('final-score-display').innerText = `${quizState.score} / ${quizData.length}`;
            document.getElementById('correct-count').innerText = quizState.score;
            document.getElementById('incorrect-count').innerText = quizData.length - quizState.score;
            
            showView('view-quiz-results');
        }

        function getScores() {
            const data = localStorage.getItem(STORAGE_KEY);
            return data ? JSON.parse(data) : {};
        }

        function saveScore(studentId, score, maxScore) {
            if (!studentId) return;
            const scores = getScores();
            
            if (!scores[studentId]) {
                scores[studentId] = {
                    latest: score,
                    best: score,
                    attempts: 1,
                    status: 'Completed'
                };
            } else {
                scores[studentId].latest = score;
                if (score > scores[studentId].best) {
                    scores[studentId].best = score;
                }
                scores[studentId].attempts += 1;
            }
            
            localStorage.setItem(STORAGE_KEY, JSON.stringify(scores));
        }

        function renderScoreboard() {
            const scores = getScores();
            const tbody = document.getElementById('scoreboard-body');
            tbody.innerHTML = '';
            
            let totalScore = 0;
            let completedCount = 0;
            
            for (let i = 1; i <= TOTAL_STUDENTS; i++) {
                const s = scores[i] || { latest: '—', best: '—', attempts: 0, status: 'Not Started' };
                
                if (s.attempts > 0) {
                    completedCount++;
                    totalScore += s.latest;
                }
                
                const statusColor = s.status === 'Completed' ? 'text-green-600 font-bold' : 'text-gray-400';
                
                const tr = document.createElement('tr');
                tr.className = "border-b border-gray-200 hover:bg-gray-100 transition-colors";
                tr.innerHTML = `
                    <td class="p-2 font-semibold text-gray-800">Student ${i}</td>
                    <td class="p-2 font-bold">${s.latest !== '—' ? s.latest + '/5' : '—'}</td>
                    <td class="p-2 font-bold text-teal-600">${s.best !== '—' ? s.best + '/5' : '—'}</td>
                    <td class="p-2">${s.attempts}</td>
                    <td class="p-2 ${statusColor}">${s.status}</td>
                `;
                tbody.appendChild(tr);
            }
            
            document.getElementById('stats-completed').innerText = `${completedCount} / ${TOTAL_STUDENTS}`;
            if (completedCount > 0) {
                const avg = (totalScore / completedCount).toFixed(1);
                document.getElementById('stats-average').innerText = `${avg} / 5`;
            } else {
                document.getElementById('stats-average').innerText = `-`;
            }
        }

        function promptClearScores() {
            showModal(
                "Clear All Scores?", 
                "Are you sure you want to delete all saved scores for all students? This cannot be undone.",
                () => {
                    localStorage.removeItem(STORAGE_KEY);
                    renderScoreboard();
                },
                true
            );
        }

        function downloadCSV() {
            const scores = getScores();
            let csvContent = "data:text/csv;charset=utf-8,\uFEFF"; 
            csvContent += "Student Number,Latest Score,Best Score,Attempts,Status\n";
            
            for (let i = 1; i <= TOTAL_STUDENTS; i++) {
                const s = scores[i] || { latest: '—', best: '—', attempts: 0, status: 'Not Started' };
                csvContent += `Student ${i},${s.latest},${s.best},${s.attempts},${s.status}\n`;
            }
            
            const encodedUri = encodeURI(csvContent);
            const link = document.createElement("a");
            link.setAttribute("href", encodedUri);
            link.setAttribute("download", "classroom_english_scores.csv");
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }
    </script>
</body>
</html>