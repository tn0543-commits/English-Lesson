                <div class="mt-4 flex-shrink-0">
                    <button onclick="goHome()" class="btn bg-gray-200 hover:bg-gray-300 text-gray-800 px-8 py-2 rounded-full font-bold text-lg shadow-md inline-flex items-center gap-2">
