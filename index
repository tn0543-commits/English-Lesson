                                <button class="btn bg-blue-50 hover:bg-blue-100 text-blue-700 py-1.5 rounded-xl font-bold flex flex-col items-center justify-center text-[10px] sm:text-xs border border-blue-200" onclick="speak('Could you repeat that, please?', 0.6)"><span class="text-base">🐢</span>Slow</button>
                                <button class="btn bg-blue-500 hover:bg-blue-600 text-white py-1.5 rounded-xl font-bold flex flex-col items-center justify-center text-[10px] sm:text-xs shadow-sm" onclick="speak('Could you repeat that, please?', 1.0)"><span class="text-base">🔊</span>Normal</button>
                                <button class="btn bg-blue-50 hover:bg-blue-100 text-blue-700 py-1.5 rounded-xl font-bold flex flex-col items-center justify-center text-[10px] sm:text-xs border border-blue-200" onclick="speak('Could you repeat that, please?', 1.5)"><span class="text-base">🐇</span>Fast</button>
                            </div>
                        </div>
                        <div class="bg-white p-4 rounded-2xl shadow-sm border border-gray-100 flex flex-col items-center text-center relative card-hover">
                            <span class="text-3xl mb-2">🐢</span>
                            <p class="text-lg font-bold text-gray-800 mb-3 flex-grow">Can you speak slower, please?</p>
                            <div class="grid grid-cols-3 gap-2 w-full mt-auto">
                                <button class="btn bg-blue-50 hover:bg-blue-100 text-blue-700 py-1.5 rounded-xl font-bold flex flex-col items-center justify-center text-[10px] sm:text-xs border border-blue-200" onclick="speak('Can you speak slower, please?', 0.6)"><span class="text-base">🐢</span>Slow</button>
                                <button class="btn bg-blue-500 hover:bg-blue-600 text-white py-1.5 rounded-xl font-bold flex flex-col items-center justify-center text-[10px] sm:text-xs shadow-sm" onclick="speak('Can you speak slower, please?', 1.0)"><span class="text-base">🔊</span>Normal</button>
                                <button class="btn bg-blue-50 hover:bg-blue-100 text-blue-700 py-1.5 rounded-xl font-bold flex flex-col items-center justify-center text-[10px] sm:text-xs border border-blue-200" onclick="speak('Can you speak slower, please?', 1.5)"><span class="text-base">🐇</span>Fast</button>
                            </div>
                        </div>
                        <div class="bg-white p-4 rounded-2xl shadow-sm border border-gray-100 flex flex-col items-center text-center relative card-hover">
                            <span class="text-3xl mb-2">🆘</span>
                            <p class="text-lg font-bold text-gray-800 mb-3 flex-grow">Can you help me with this, please?</p>
                            <div class="grid grid-cols-3 gap-2 w-full mt-auto">
                                <button class="btn bg-blue-50 hover:bg-blue-100 text-blue-700 py-1.5 rounded-xl font-bold flex flex-col items-center justify-center text-[10px] sm:text-xs border border-blue-200" onclick="speak('Can you help me with this, please?', 0.6)"><span class="text-base">🐢</span>Slow</button>
                                <button class="btn bg-blue-500 hover:bg-blue-600 text-white py-1.5 rounded-xl font-bold flex flex-col items-center justify-center text-[10px] sm:text-xs shadow-sm" onclick="speak('Can you help me with this, please?', 1.0)"><span class="text-base">🔊</span>Normal</button>
                                <button class="btn bg-blue-50 hover:bg-blue-100 text-blue-700 py-1.5 rounded-xl font-bold flex flex-col items-center justify-center text-[10px] sm:text-xs border border-blue-200" onclick="speak('Can you help me with this, please?', 1.5)"><span class="text-base">🐇</span>Fast</button>
                            </div>
                        </div>
                    </div>

                    <!-- Dialogue -->
                    <div class="bg-white p-4 rounded-2xl shadow-inner border border-gray-100">
                        <h3 class="text-lg font-bold text-gray-700 mb-2 border-b pb-1">Sample Dialogue</h3>
                        <div class="space-y-2">
                            <div class="flex items-start gap-3">
                                <div class="text-2xl pt-1">👦</div>
                                <div class="bg-blue-100 p-2 rounded-2xl rounded-tl-none w-full">
                                    <p class="font-bold text-md text-blue-900">Student: "Could you repeat that, please?"</p>
                                    <button class="mt-1 text-xs bg-white text-blue-600 px-2 py-1 rounded-full shadow-sm hover:bg-gray-50 flex items-center gap-1 font-semibold btn" onclick="speak('Could you repeat that, please?')">🔊 Listen to Student</button>
                                </div>
                            </div>
                            <div class="flex items-start gap-3 flex-row-reverse">
                                <div class="text-2xl pt-1">👩‍🏫</div>
                                <div class="bg-green-100 p-2 rounded-2xl rounded-tr-none w-full text-right">
                                    <p class="font-bold text-md text-green-900">Teacher: "Sure! No problem. Let's do it together."</p>
                                    <div class="flex justify-end mt-1">
                                        <button class="text-xs bg-white text-green-600 px-2 py-1 rounded-full shadow-sm hover:bg-gray-50 flex items-center gap-1 font-semibold btn" onclick="speak('Sure! No problem. Let\'s do it together.')">Listen to Teacher 🔊</button>
                                    </div>
                                </div>
                            </div>
                            <div class="flex justify-center pt-2">
                                <div class="grid grid-cols-3 gap-2 w-full md:w-auto">
                                    <button class="btn bg-blue-100 hover:bg-blue-200 text-blue-800 px-3 py-1.5 rounded-full font-bold shadow-sm flex items-center justify-center gap-1 text-xs" onclick="playDialogue(['Could you repeat that, please?', 'Sure! No problem. Let\'s do it together.'], 0.6)">🐢 Slow</button>
                                    <button class="btn bg-blue-500 hover:bg-blue-600 text-white px-4 py-1.5 rounded-full font-bold shadow-md flex items-center justify-center gap-1 text-xs" onclick="playDialogue(['Could you repeat that, please?', 'Sure! No problem. Let\'s do it together.'], 1.0)">▶️ Normal</button>
                                    <button class="btn bg-blue-100 hover:bg-blue-200 text-blue-800 px-3 py-1.5 rounded-full font-bold shadow-sm flex items-center justify-center gap-1 text-xs" onclick="playDialogue(['Could you repeat that, please?', 'Sure! No problem. Let\'s do it together.'], 1.5)">🐇 Fast</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Help Signal Activity -->
                    <div class="bg-yellow-50 p-4 rounded-2xl border-2 border-yellow-200 text-center flex flex-col md:flex-row items-center gap-4">
                        <div class="flex-grow text-left">
                            <h3 class="text-xl font-bold text-yellow-800 mb-1">Help Signal Activity</h3>
                            <p class="text-md font-semibold text-yellow-700 mb-2">"If you don't understand, raise your hand and ask for help in English!"</p>
                            <div class="flex gap-2 text-sm">
                                <div class="bg-white p-2 rounded-xl shadow-sm flex-1"><span class="font-bold mr-1 text-teal-500">1</span>Listen to the teacher.</div>
                                <div class="bg-white p-2 rounded-xl shadow-sm flex-1"><span class="font-bold mr-1 text-teal-500">2</span>Raise your hand.</div>
                                <div class="bg-white p-2 rounded-xl shadow-sm flex-1"><span class="font-bold mr-1 text-teal-500">3</span>Ask for help in English.</div>
                            </div>
                        </div>
                        <div class="flex-shrink-0">
                            <button id="btn-help-signal" class="btn bg-red-500 hover:bg-red-600 text-white px-6 py-3 rounded-full font-extrabold text-xl shadow-lg border-4 border-red-300 animate-pulse" onclick="toggleHelpExpressions()">
                                HELP! 🙋‍♂️
                            </button>
                        </div>
                    </div>
                    <div id="help-expressions" class="hidden bg-white p-3 rounded-xl shadow border border-yellow-200 mt-2">
                        <ul class="text-left text-sm font-bold text-gray-800 space-y-2">
                            <li class="flex items-center gap-2 cursor-pointer hover:text-blue-600" onclick="speak('Could you repeat that, please?')">🔊 Could you repeat that, please?</li>
                            <li class="flex items-center gap-2 cursor-pointer hover:text-blue-600" onclick="speak('Can you speak slower, please?')">🔊 Can you speak slower, please?</li>
                            <li class="flex items-center gap-2 cursor-pointer hover:text-blue-600" onclick="speak('Can you help me with this, please?')">🔊 Can you help me with this, please?</li>
                        </ul>
                    </div>
                </div>
            </div>
            
            <div class="text-center mt-3 flex-shrink-0">
                <button onclick="showView('view-lesson-2')" class="btn bg-blue-600 hover:bg-blue-700 text-white px-8 py-2 rounded-full font-bold text-lg shadow-md">
                    Next Lesson ➡️
                </button>
            </div>
        </section>

        <section id="view-lesson-2" class="view-section hidden h-full w-full flex flex-col justify-center overflow-y-auto">
            <div class="bg-white rounded-3xl shadow-xl overflow-hidden border-2 border-green-100 flex flex-col h-[95%]">
                <div class="bg-green-500 text-white p-3 md:p-4 text-center flex-shrink-0">
                    <h2 class="text-2xl font-bold">Lesson 2: Asking Permission</h2>
                </div>
                
                <div class="p-4 md:p-6 space-y-4 bg-green-50/50 flex-grow flex flex-col justify-around">
                    <!-- Sentences -->
                    <div class="grid grid-cols-2 md:grid-cols-5 gap-2 md:gap-4">
                        <div class="bg-white p-3 rounded-2xl shadow-sm border border-gray-100 flex flex-col items-center text-center card-hover">
                            <span class="text-2xl mb-1">🚪🏃</span>
                            <p class="text-sm font-bold text-gray-800 mb-2 flex-grow">May I come in, please?</p>
                            <div class="flex gap-1 w-full mt-auto">
                                <button class="btn bg-green-50 hover:bg-green-100 text-green-700 py-1 rounded-lg font-bold flex flex-col items-center justify-center text-[10px] border border-green-200 w-full" onclick="speak('May I come in, please?', 0.6)">🐢</button>
                                <button class="btn bg-green-500 hover:bg-green-600 text-white py-1 rounded-lg font-bold flex flex-col items-center justify-center text-[10px] shadow-sm w-full" onclick="speak('May I come in, please?', 1.0)">🔊</button>
                                <button class="btn bg-green-50 hover:bg-green-100 text-green-700 py-1 rounded-lg font-bold flex flex-col items-center justify-center text-[10px] border border-green-200 w-full" onclick="speak('May I come in, please?', 1.5)">🐇</button>
                            </div>
                        </div>
                        <div class="bg-white p-3 rounded-2xl shadow-sm border border-gray-100 flex flex-col items-center text-center card-hover">
                            <span class="text-2xl mb-1">🪟👐</span>
                            <p class="text-sm font-bold text-gray-800 mb-2 flex-grow">Can I open the window, please?</p>
                            <div class="flex gap-1 w-full mt-auto">
                                <button class="btn bg-green-50 hover:bg-green-100 text-green-700 py-1 rounded-lg font-bold flex flex-col items-center justify-center text-[10px] border border-green-200 w-full" onclick="speak('Can I open the window, please?', 0.6)">🐢</button>
                                <button class="btn bg-green-500 hover:bg-green-600 text-white py-1 rounded-lg font-bold flex flex-col items-center justify-center text-[10px] shadow-sm w-full" onclick="speak('Can I open the window, please?', 1.0)">🔊</button>
                                <button class="btn bg-green-50 hover:bg-green-100 text-green-700 py-1 rounded-lg font-bold flex flex-col items-center justify-center text-[10px] border border-green-200 w-full" onclick="speak('Can I open the window, please?', 1.5)">🐇</button>
                            </div>
                        </div>
                        <div class="bg-white p-3 rounded-2xl shadow-sm border border-gray-100 flex flex-col items-center text-center card-hover">
                            <span class="text-2xl mb-1">🪟✊</span>
                            <p class="text-sm font-bold text-gray-800 mb-2 flex-grow">Can I close the window, please?</p>
                            <div class="flex gap-1 w-full mt-auto">
                                <button class="btn bg-green-50 hover:bg-green-100 text-green-700 py-1 rounded-lg font-bold flex flex-col items-center justify-center text-[10px] border border-green-200 w-full" onclick="speak('Can I close the window, please?', 0.6)">🐢</button>
                                <button class="btn bg-green-500 hover:bg-green-600 text-white py-1 rounded-lg font-bold flex flex-col items-center justify-center text-[10px] shadow-sm w-full" onclick="speak('Can I close the window, please?', 1.0)">🔊</button>
                                <button class="btn bg-green-50 hover:bg-green-100 text-green-700 py-1 rounded-lg font-bold flex flex-col items-center justify-center text-[10px] border border-green-200 w-full" onclick="speak('Can I close the window, please?', 1.5)">🐇</button>
                            </div>
                        </div>
                        <div class="bg-white p-3 rounded-2xl shadow-sm border border-gray-100 flex flex-col items-center text-center card-hover">
                            <span class="text-2xl mb-1">🚪👐</span>
                            <p class="text-sm font-bold text-gray-800 mb-2 flex-grow">Can I open the door, please?</p>
                            <div class="flex gap-1 w-full mt-auto">
                                <button class="btn bg-green-50 hover:bg-green-100 text-green-700 py-1 rounded-lg font-bold flex flex-col items-center justify-center text-[10px] border border-green-200 w-full" onclick="speak('Can I open the door, please?', 0.6)">🐢</button>
                                <button class="btn bg-green-500 hover:bg-green-600 text-white py-1 rounded-lg font-bold flex flex-col items-center justify-center text-[10px] shadow-sm w-full" onclick="speak('Can I open the door, please?', 1.0)">🔊</button>
                                <button class="btn bg-green-50 hover:bg-green-100 text-green-700 py-1 rounded-lg font-bold flex flex-col items-center justify-center text-[10px] border border-green-200 w-full" onclick="speak('Can I open the door, please?', 1.5)">🐇</button>
                            </div>
                        </div>
                        <div class="bg-white p-3 rounded-2xl shadow-sm border border-gray-100 flex flex-col items-center text-center card-hover">
