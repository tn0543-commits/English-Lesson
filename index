            </div>
        </div>
    </div>

    <main class="flex-grow p-2 md:p-4 max-w-6xl mx-auto w-full flex flex-col relative overflow-hidden h-full">
        
        <section id="view-main-menu" class="view-section flex flex-col justify-center items-center h-full w-full">
            <div class="text-center mb-6 md:mb-10">
                <h2 class="text-5xl md:text-7xl lg:text-8xl font-black text-transparent bg-clip-text bg-gradient-to-r from-blue-600 via-purple-600 to-pink-600 mb-4 drop-shadow-sm transform hover:scale-105 transition-transform duration-500">Classroom English</h2>
                <h3 class="text-2xl md:text-3xl font-bold text-gray-700 bg-white/60 inline-block px-8 py-3 rounded-full shadow-sm border border-white/50 backdrop-blur-sm">Asking for Help & Permission</h3>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-8 max-w-5xl mx-auto w-full px-4">
                <button onclick="showView('view-lesson')" class="btn card-hover bg-gradient-to-br from-blue-400 to-blue-600 p-6 rounded-3xl shadow-xl flex flex-col items-center text-center group text-white border-4 border-white/30 hover:border-white/70">
                    <div class="text-6xl mb-3 group-hover:scale-110 group-hover:rotate-6 transition-all drop-shadow-lg">📖</div>
                    <h3 class="text-3xl font-bold drop-shadow-md">Start Lesson</h3>
                </button>
                
                <button onclick="showView('view-listening')" class="btn card-hover bg-gradient-to-br from-purple-400 to-purple-600 p-6 rounded-3xl shadow-xl flex flex-col items-center text-center group text-white border-4 border-white/30 hover:border-white/70">
                    <div class="text-6xl mb-3 group-hover:scale-110 group-hover:-rotate-6 transition-all drop-shadow-lg">🎧</div>
                    <h3 class="text-3xl font-bold drop-shadow-md text-center">Listening Practice</h3>
                </button>

                <button onclick="prepareQuiz()" class="btn card-hover bg-gradient-to-br from-orange-400 to-pink-500 p-6 rounded-3xl shadow-xl flex flex-col items-center text-center group text-white border-4 border-white/30 hover:border-white/70">
                    <div class="text-6xl mb-3 group-hover:scale-110 group-hover:rotate-12 transition-all drop-shadow-lg">✍️</div>
                    <h3 class="text-3xl font-bold drop-shadow-md">Exercise 1 — Quiz</h3>
                </button>
            </div>
            
            <div class="mt-8 text-center">
